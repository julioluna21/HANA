# HANA — Fotos de las novedades
# Esta carpeta NO se abre por la dirección del navegador: las fotos solo se
# entregan por Control/NovedadesControl.php (op=foto), que revisa quién las pide.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
